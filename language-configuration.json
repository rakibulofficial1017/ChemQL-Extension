{
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "///",
      "///"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    },
    {
      "open": "`",
      "close": "`"
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ],
    [
      "`",
      "`"
    ]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|@[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:if\\b.*|for\\b.*|while\\b.*|namespace\\b.*|struct\\b.*|record\\b.*|enum\\b.*|define\\b.*|macro\\b.*|func(?:tion)?\\b.*|risk\\b.*)$",
    "decreaseIndentPattern": "^\\s*(?:else\\b|elif\\b|endif\\b|endfor\\b|endwhile\\b|endnamespace\\b|endstruct\\b|endrecord\\b|endenum\\b|enddefine\\b|endmacro\\b|endfunc\\b|endfunction\\b|endrisk\\b)"
  }
}
